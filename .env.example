NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Server only (cron job writes prayer times). Never expose to the browser.
SUPABASE_SECRET_KEY=sb_secret_...
CRON_SECRET=any-long-random-string

# Masjid location, used by any screen in API mode (see /admin/screens) and by the weather badge.
PRAYER_LAT=21.4225
PRAYER_LON=39.8262
PRAYER_TIMEZONE=Asia/Riyadh
PRAYER_CALC_METHOD=2          # Aladhan method (2 = ISNA)
TEMP_UNIT=fahrenheit          # fahrenheit | celsius

# Legacy names, still read as a fallback if the PRAYER_* ones above are not set:
# MASJID_LAT, MASJID_LON

# Stripe Terminal (only needed for the mobile app's in-person Donations tab)
STRIPE_SECRET_KEY=sk_live_or_sk_test_...
