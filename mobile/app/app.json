{
  "expo": {
    "name": "SCMEC",
    "slug": "scmec-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "scheme": "scmec",

    "sdkVersion": "57.0.0",
    "platforms": ["ios", "android"],
    "runtimeVersion": { "policy": "sdkVersion" },

    "plugins": [
      [
        "@stripe/stripe-terminal-react-native",
        {
          "bluetoothBackgroundMode": true,
          "locationWhenInUsePermission": "Location is used to discover nearby Stripe card readers."
        }
      ]
    ],
    "ios": { ... },
    "android": { ... },
    "extra": { ... },
    "owner": "moelmsallati"
  }
}
